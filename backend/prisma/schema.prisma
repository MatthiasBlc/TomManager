generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Session storage for express-session
model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  username        String    @unique
  passwordHash    String?
  discordId       String?   @unique
  discordUsername String?
  displayName     String?
  avatarUrl       String?
  role            Role      @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  createdEvents                 Event[]
  eventParticipations           EventParticipation[]
  createdGameTables             GameTable[]
  gameTableParticipations       GameTableParticipant[]
  eventBoardGames               EventBoardGame[]
  notifications                 Notification[]
  preferences                   UserPreference[]
  kitchenChefRoster             KitchenChef[]
  kitchenCoursesMemberships     KitchenCoursesMember[]
  meals                         Meal[]
  mealAssistances               MealAssistant[]
  sentSwapRequests              MealSwapRequest[]      @relation("SwapRequester")
  receivedSwapRequests          MealSwapRequest[]      @relation("SwapTarget")
  sentAssistantSwapRequests     AssistantSwapRequest[] @relation("AssistantSwapRequester")
  acceptedAssistantSwapRequests AssistantSwapRequest[] @relation("AssistantSwapAccepter")
}

// Preferences utilisateur (toggles admin/beta, extensible a d'autres options)
model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     Boolean
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Event {
  id            String   @id @default(uuid())
  name          String
  startDateTime DateTime
  endDateTime   DateTime
  createdBy     String
  discordRoleId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator         User                 @relation(fields: [createdBy], references: [id])
  participations  EventParticipation[]
  gameTables      GameTable[]
  eventBoardGames EventBoardGame[]
  kitchen         EventKitchen?

  @@index([createdBy])
}

model EventParticipation {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
}

model GameTable {
  id            String    @id @default(uuid())
  eventId       String
  createdBy     String
  title         String
  type          TableType @default(JDR)
  gmIsPlayer    Boolean   @default(false)
  pitch         String?
  triggers      String?
  comments      String?
  maxPlayers    Int
  reservedSeats Int       @default(0)
  startDateTime DateTime
  endDateTime   DateTime
  boardGameId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  event        Event                  @relation(fields: [eventId], references: [id])
  creator      User                   @relation(fields: [createdBy], references: [id])
  tags         GameTableTag[]
  participants GameTableParticipant[]
  boardGame    BoardGame?             @relation(fields: [boardGameId], references: [id], onDelete: SetNull)

  @@index([eventId, startDateTime])
}

model Tag {
  id   String @id @default(uuid())
  name String @unique

  gameTables GameTableTag[]
}

model GameTableTag {
  gameTableId String
  tagId       String

  gameTable GameTable @relation(fields: [gameTableId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id])

  @@id([gameTableId, tagId])
}

model GameTableParticipant {
  id               String                 @id @default(uuid())
  gameTableId      String
  userId           String
  status           TableParticipantStatus @default(CONFIRMED)
  isOnReservedSeat Boolean                @default(false)
  joinedAt         DateTime               @default(now())

  gameTable GameTable @relation(fields: [gameTableId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([gameTableId, userId])
  @@index([gameTableId, status])
  @@index([userId])
}

model BoardGame {
  id             String   @id @default(uuid())
  name           String
  externalSource String?
  externalId     String?
  yearPublished  Int?
  minPlayers     Int?
  maxPlayers     Int?
  playingTime    Int?
  description    String?
  imageUrl       String?
  createdAt      DateTime @default(now())

  eventBoardGames EventBoardGame[]
  gameTables      GameTable[]

  @@unique([externalSource, externalId])
  @@index([name])
}

model EventBoardGame {
  id              String   @id @default(uuid())
  eventId         String
  boardGameId     String
  broughtByUserId String
  createdAt       DateTime @default(now())

  event     Event     @relation(fields: [eventId], references: [id])
  boardGame BoardGame @relation(fields: [boardGameId], references: [id])
  broughtBy User      @relation(fields: [broughtByUserId], references: [id])

  @@unique([eventId, boardGameId, broughtByUserId])
  @@index([eventId])
}

enum Role {
  USER
  ADMIN
}

enum TableParticipantStatus {
  CONFIRMED
  WAITLIST
}

enum TableType {
  JDR
  JDS
}

enum NotificationType {
  TABLE_DELETED
  TABLE_UPDATED
  WAITLIST_PROMOTED
  WAITLIST_DEMOTED
  RESERVED_SEAT_ASSIGNED
  PLAYER_KICKED
  PARTICIPANT_REMOVED
  EVENT_UPDATED
  EVENT_DELETED
  GM_PLAYER_JOINED
  GM_PLAYER_WAITLISTED
  GM_PLAYER_LEFT
  GM_TABLE_FULL
  KITCHEN_SWAP_REQUESTED
  KITCHEN_SWAP_ACCEPTED
  KITCHEN_SWAP_REJECTED
  KITCHEN_ASSISTANT_SWAP_REQUESTED
  KITCHEN_ASSISTANT_SWAP_ACCEPTED
  KITCHEN_CHEF_ADDED
  KITCHEN_CHEF_REMOVED
  KITCHEN_MEAL_CLAIMED
  KITCHEN_OVERCAPACITY
  KITCHEN_DIET_SPLIT_UPDATED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read, createdAt(sort: Desc)])
}

// Module cuisine (CookV1) - voir docs/features/CookV1/SPEC_COOKING.md

model EventKitchen {
  id                      String   @id @default(uuid())
  eventId                 String   @unique
  chefRoleId              String?
  allergiesNotes          String?
  dislikesNotes           String?
  equipierPlanningEnabled Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  event                 Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  chefs                 KitchenChef[]
  coursesMembers        KitchenCoursesMember[]
  meals                 Meal[]
  assistants            MealAssistant[]
  mealSwapRequests      MealSwapRequest[]
  assistantSwapRequests AssistantSwapRequest[]
}

model KitchenChef {
  id             String     @id @default(uuid())
  eventKitchenId String
  userId         String
  source         ChefSource

  eventKitchen EventKitchen @relation(fields: [eventKitchenId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([eventKitchenId, userId])
}

model KitchenCoursesMember {
  id             String @id @default(uuid())
  eventKitchenId String
  userId         String

  eventKitchen EventKitchen @relation(fields: [eventKitchenId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([eventKitchenId, userId])
}

model Meal {
  id             String      @id @default(uuid())
  eventKitchenId String
  chefUserId     String?
  name           String
  service        MealService
  startDateTime  DateTime
  endDateTime    DateTime
  maxAssistants  Int         @default(0)
  vegeCount      Int         @default(0)
  carneCount     Int         @default(0)
  // Zone de texte libre du chef : recette collee, deroule, instructions, remarques.
  // Aucune structure imposee (ni markdown ni etapes) : c'est un bloc-notes, les sauts
  // de ligne saisis sont conserves tels quels a l'affichage.
  recipe         String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  eventKitchen EventKitchen     @relation(fields: [eventKitchenId], references: [id], onDelete: Cascade)
  chef         User?            @relation(fields: [chefUserId], references: [id])
  ingredients  MealIngredient[]
  utensils     MealUtensil[]
  assistants   MealAssistant[]

  swapRequestsAsRequester MealSwapRequest[] @relation("SwapRequesterMeal")
  swapRequestsAsTarget    MealSwapRequest[] @relation("SwapTargetMeal")

  assistantSwapRequestsAsRequesterMeal AssistantSwapRequest[] @relation("AssistantSwapRequesterMeal")
  assistantSwapRequestsAsTargetMeal    AssistantSwapRequest[] @relation("AssistantSwapTargetMeal")

  @@unique([eventKitchenId, chefUserId])
  @@index([eventKitchenId, startDateTime])
}

model MealIngredient {
  id        String  @id @default(uuid())
  mealId    String
  productId String?
  name      String
  quantity  Decimal @db.Decimal(10, 3)
  unit      Unit
  // Commentaire libre du chef sur CETTE ligne de recette, a destination de l'equipe
  // courses (ex. "de preference agrume ou acacia", "si 300 ml n'est pas plus cher").
  // Porte par la ligne et non par le Product : la meme denree peut demander une
  // precision differente d'une recette a l'autre.
  note      String?
  // Rang de la ligne dans la recette du chef (0 = premiere). L'ordre des ingredients
  // est une information a part entiere (ordre de preparation, regroupement par rayon) :
  // sans colonne dediee, l'ordre rendu dependait de l'ordre physique des lignes en
  // base, non garanti par PostgreSQL. Reecrit en bloc a chaque PATCH de la recette.
  position  Int     @default(0)

  meal    Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([mealId, position])
}

model Product {
  id   String @id @default(uuid())
  name String @unique

  mealIngredients MealIngredient[]
}

model MealUtensil {
  id        String  @id @default(uuid())
  mealId    String
  utensilId String?
  name      String

  meal    Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  utensil Utensil? @relation(fields: [utensilId], references: [id])
}

model Utensil {
  id   String @id @default(uuid())
  name String @unique

  mealUtensils MealUtensil[]
}

model MealAssistant {
  id             String   @id @default(uuid())
  mealId         String
  eventKitchenId String
  userId         String
  createdAt      DateTime @default(now())

  meal         Meal         @relation(fields: [mealId], references: [id], onDelete: Cascade)
  eventKitchen EventKitchen @relation(fields: [eventKitchenId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([mealId, userId])
  @@unique([eventKitchenId, userId])
}

// Demande d'echange de creneau entre deux chefs (confirmation mutuelle).
// A l'acceptation, la recette (name + ingredients + ustensiles) et le chef suivent
// dans l'echange, mais les equipiers (MealAssistant) et les horaires/service/capacite
// restent attaches au creneau (slot) d'origine.
model MealSwapRequest {
  id              String     @id @default(uuid())
  eventKitchenId  String
  requesterMealId String
  targetMealId    String
  requesterUserId String
  targetUserId    String
  status          SwapStatus @default(PENDING)
  createdAt       DateTime   @default(now())
  respondedAt     DateTime?

  eventKitchen  EventKitchen @relation(fields: [eventKitchenId], references: [id], onDelete: Cascade)
  requesterMeal Meal         @relation("SwapRequesterMeal", fields: [requesterMealId], references: [id], onDelete: Cascade)
  targetMeal    Meal         @relation("SwapTargetMeal", fields: [targetMealId], references: [id], onDelete: Cascade)
  requester     User         @relation("SwapRequester", fields: [requesterUserId], references: [id])
  target        User         @relation("SwapTarget", fields: [targetUserId], references: [id])

  @@index([eventKitchenId, status])
  @@index([targetMealId, status])
}

// Demande d'echange entre equipiers (point 4, Evolutions.md) : la cible est un
// REPAS, pas une personne — n'importe quel MealAssistant courant du repas cible
// peut accepter (premier arrive, premier servi). Echange 1-pour-1 des
// MealAssistant.mealId (capacite-neutre). accepterUserId n'est renseigne qu'a
// l'acceptation (inconnu a la creation).
model AssistantSwapRequest {
  id              String     @id @default(uuid())
  eventKitchenId  String
  requesterMealId String
  targetMealId    String
  requesterUserId String
  accepterUserId  String?
  status          SwapStatus @default(PENDING)
  createdAt       DateTime   @default(now())
  respondedAt     DateTime?

  eventKitchen  EventKitchen @relation(fields: [eventKitchenId], references: [id], onDelete: Cascade)
  requesterMeal Meal         @relation("AssistantSwapRequesterMeal", fields: [requesterMealId], references: [id], onDelete: Cascade)
  targetMeal    Meal         @relation("AssistantSwapTargetMeal", fields: [targetMealId], references: [id], onDelete: Cascade)
  requester     User         @relation("AssistantSwapRequester", fields: [requesterUserId], references: [id])
  accepter      User?        @relation("AssistantSwapAccepter", fields: [accepterUserId], references: [id])

  @@index([eventKitchenId, status])
  @@index([targetMealId, status])
  @@index([requesterUserId, status])
}

enum SwapStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ChefSource {
  ROLE
  MANUAL
}

enum MealService {
  LUNCH
  DINNER
}

enum Unit {
  G
  KG
  ML
  CL
  L
  CAS
  CAC
  PIECE
}
