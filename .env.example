# ========================================
# TomManager - Environment Variables
# ========================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control

# ========================================
# Docker Compose
# ========================================
COMPOSE_PROJECT_NAME=tommanager

# ========================================
# PostgreSQL
# ========================================
POSTGRES_USER=tommanager
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=tommanager_db

# ========================================
# Backend
# ========================================
PORT=3001
SESSION_SECRET=your_session_secret_here_min_32_chars
CORS_ORIGIN=http://localhost:3000

# ========================================
# Frontend
# ========================================
VITE_BACKEND_URL=http://localhost:3001

# ========================================
# Discord OAuth2 (Phase 15a)
# ========================================
# Creer une application sur https://discord.com/developers/applications
# Le bot doit etre dans le serveur Discord (permission minimale `bot`)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback
# Optionnel : ID du role Discord qui donne les droits ADMIN dans TomManager
DISCORD_ADMIN_ROLE_ID=

# ========================================
# Discord Bot (Phase 15b)
# ========================================
# Token du bot — onglet "Bot" dans Discord Developer Portal
# Activer "Server Members Intent" (Privileged Gateway Intents)
DISCORD_BOT_TOKEN=your_discord_bot_token

# ========================================
# BoardGameGeek API (Phase 14)
# ========================================
# Enregistrer l'app sur https://boardgamegeek.com/applications/create
# pour obtenir le Bearer Token
BGG_API_TOKEN=

# ========================================
# Sentry (optionnel)
# ========================================
# DSN backend (Node) et frontend (browser) — laisser vide pour desactiver
SENTRY_DSN=
VITE_SENTRY_DSN=

# ========================================
# Production Only (GitHub Secrets)
# ========================================
# REGISTRY_URL=registry.example.com
# IMAGE_NAME=tommanager
# PORTAINER_URL=https://portainer.example.com
# PORTAINER_API=your_portainer_api_key
# STACK_ID=your_stack_id
# ENDPOINT_ID=your_endpoint_id
